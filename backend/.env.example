# Server
PORT=3000
NODE_ENV=development

# Database
# Example for local MongoDB. Use your production connection string in deployment.
DATABASE_URL=mongodb://localhost:27017/clothswap

# Authentication
JWT_SECRET=your_jwt_secret_here
SALT_ROUNDS=10

# Client
# URL where the frontend is served (used for CORS, email links, etc.)
CLIENT_URL=http://localhost:5173

# Uploads
UPLOADS_DIR=uploads/

# Email / SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Cloudinary / S3 (optional - used if storing images in cloud)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging
LOG_LEVEL=info

# Note: Do NOT store real secrets in this file in the repository.
#       Keep a local `backend/.env` (ignored by git) with real values.
